SUPABASE_URL=your_supabase_url_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here
# Service-role key (server-only, NEVER expose to the client). Set this so the
# backend can access the DB after RLS is locked down to deny the anon role.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
PORT=3001

# Comma-separated browser origins allowed to call the API (CORS allowlist).
ALLOWED_ORIGINS=https://risk.infopaceindia.co.in
# Secret used to sign short-lived upload tokens. If unset, the Razorpay secret
# is reused. Use a long random string.
APP_SECRET=change_me_to_a_long_random_string

# Razorpay (server-side). Get these from the Razorpay Dashboard → Settings → API Keys.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
# Price of the report in the smallest currency unit (paise). 100 = ₹1.00
RAZORPAY_AMOUNT=100
RAZORPAY_CURRENCY=INR

# Where /payment-status sends the user back to after verifying the payment.
FRONTEND_URL=https://risk.infopaceindia.co.in

# Secret key that protects the admin results view (/api/admin/assessments).
# Open the admin page at:  https://risk.infopaceindia.co.in/?admin=YOUR_ADMIN_KEY
ADMIN_KEY=change_me_to_a_long_random_string

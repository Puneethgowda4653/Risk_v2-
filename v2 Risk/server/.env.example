SUPABASE_URL=your_supabase_url_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here
PORT=3001

# Razorpay (server-side). Get these from the Razorpay Dashboard → Settings → API Keys.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
# Price of the report in the smallest currency unit (paise). 100 = ₹1.00
RAZORPAY_AMOUNT=100
RAZORPAY_CURRENCY=INR

# Where /payment-status sends the user back to after verifying the payment.
FRONTEND_URL=https://risk.infopaceindia.co.in
